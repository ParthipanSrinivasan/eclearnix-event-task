PORT=5000
NODE_ENV=development

# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
# Local MongoDB:  mongodb://127.0.0.1:27017/event-management
# Atlas:          mongodb+srv://<user>:<password>@<cluster>/event-management
MONGO_URI=

# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS.
CLIENT_URL=http://localhost:5173

# Accounts created automatically on first start (if they don't exist yet).
# Admin: manages events.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Demo user: browses and registers for events. Leave USER_EMAIL empty to skip.
USER_NAME=Demo User
USER_EMAIL=user@example.com
USER_PASSWORD=User@1234
